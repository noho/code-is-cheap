#!/bin/zsh

# Orchestrator contract: always pass --cwd explicitly so every child agent has
# a deterministic workspace instead of inheriting the controller's directory.

emulate -LR zsh
setopt no_unset pipe_fail noclobber
umask 077
typeset -F 6 SECONDS

readonly agent_run_script_dir="${0:A:h}"
readonly PROGRAM_NAME="${0:t}"
readonly DEFAULT_AGENT_TOOLS_FILE="$HOME/.config/zsh/agent-tools.zsh"

usage() {
  cat <<'EOF'
Usage:
  claude-agent-run --provider <ds-flash|mimo|mimo-fast|mimo-flash|qwen|kimi|glm|glm-flash|local|hy> [options] --prompt <text>
  claude-agent-run --provider <provider> [options] --prompt-file <path>
  printf '%s' '<prompt>' | claude-agent-run --provider <provider> [options]

Required:
  --provider <name>          Model provider: ds-flash, mimo, mimo-fast, mimo-flash, qwen, kimi, glm, glm-flash, local, or hy.

Prompt input (choose one):
  --prompt <text>            Prompt text.
  --prompt-file <path>       Read the prompt from a UTF-8 text file; use - for stdin.
  <positional text>          Remaining positional arguments are joined with spaces.
  stdin                      Used when no other prompt input is supplied.

Run options:
  --instance <name>          Unique display name. Defaults to <provider>-<uuid-prefix>.
  --cwd <directory>          Working directory. Defaults to the current directory.
  --output-format <format>   text, json, or stream-json. Defaults to stream-json (json with --detail).
  --detail                   Return raw runtime output instead of the collected result.
  --artifact <path>          Optional NEW regular task file; repeatable. Checked after execution.
  --canary-file <path>       Optional canary input path (paired with --canary-expected).
  --canary-expected <path>   Controller's expected token file; never sent in the prompt.
  --output <path>            Save raw runtime output to a NEW private file.
  --stderr <path>            Write stderr to a NEW private file; existing paths are rejected.
  --permission-mode <mode>   Pass a Claude Code permission mode unchanged.
  --full-access              Disable the runtime sandbox and bypass tool approvals (opt-in).
  --persist                  Save the session; generates a UUID when needed.
  --session-id <uuid>        Save a new session with this UUID.
  --resume <session-id>      Resume an existing session.
  --no-persist               Do not save the session (default for new runs).
  --list-providers           Print supported providers and exit.
  -h, --help                 Show this help.
  -- <claude arguments...>   Pass additional arguments directly to Claude Code.
                             Variadic options (e.g. --allowedTools) must use = binding
                             (--allowedTools=Read,Grep): the prompt is appended last.

Environment:
  AGENT_TOOLS_FILE           Override the launcher file used by this script.

Orchestrator note:
  Always pass --cwd explicitly. Do not rely on the controller's current
  directory when launching a child agent.

Examples:
  claude-agent-run --provider ds-flash --cwd ~/workspace/project \
    --instance collector-01 --prompt-file task.md \
    --output runs/collector-01.json

  claude-agent-run --provider kimi --persist --prompt 'Collect the requested data'

  claude-agent-run --provider qwen --resume <session-id> --prompt 'Continue the review'

  claude-agent-run --provider glm --prompt-file task.md -- --verbose

  claude-agent-run --provider local --cwd ~/workspace/project \
    --prompt 'Review this repository with the local model'

Parallel runs:
  claude-agent-run --provider ds-flash --cwd ~/workspace/project --instance dsflash-01 --prompt-file task-a.md --output dsflash-01.json &
  claude-agent-run --provider ds-flash --cwd ~/workspace/project --instance dsflash-02 --prompt-file task-b.md --output dsflash-02.json &
  wait
EOF
}

die() {
  print -u2 -- "$PROGRAM_NAME: $*"
  exit 2
}

require_value() {
  local option="$1"
  local count="$2"
  (( count >= 2 )) || die "$option requires a value"
}

new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
    return
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import uuid; print(uuid.uuid4())'
    return
  fi

  die "uuidgen or python3 is required to generate a session ID"
}

# Resolve parent-directory aliases, but never follow an output-file symlink.
# This is best-effort protection for user-controlled directories, not a defense
# against another process concurrently replacing parent directories.
prepare_output_path() {
  local output_path="$1"
  local parent_directory="${output_path:h}"
  local leaf_name="${output_path:t}"

  [[ -n "$output_path" && "$output_path" != */ && "$leaf_name" != . && "$leaf_name" != .. ]] || \
    die "invalid output path: $output_path"
  [[ ! -L "$output_path" ]] || die "output must not be a symbolic link: $output_path"
  [[ -d "$parent_directory" ]] || mkdir -p -- "$parent_directory" || \
    die "cannot create directory: $parent_directory"
  REPLY="${parent_directory:A}/$leaf_name"
}

require_new_output() {
  local output_path="$1"
  [[ ! -L "$output_path" ]] || die "output must not be a symbolic link: $output_path"
  [[ ! -e "$output_path" ]] || die "output already exists (use a new filename): $output_path"
}

require_distinct_outputs() {
  [[ -z "$1" || -z "$2" ]] && return 0
  [[ "$1" != "$2" && ! "$1" -ef "$2" ]] || die "output paths refer to the same file: $1 and $2"
}

# Open both streams before starting the Agent. noclobber protects normal-file
# creation; the Agent inherits descriptors rather than reopening these paths.
open_output_streams() {
  [[ -z "$output_file" ]] || exec {stdout_fd}>"$output_file" || die "cannot create output: $output_file"
  [[ -z "$stderr_file" ]] || exec {stderr_fd}>"$stderr_file" || die "cannot create stderr: $stderr_file"
}

detail=false
canary_file=""
canary_expected=""
typeset -a artifacts=()
provider=""
instance=""
workdir="$PWD"
output_format=""
output_file=""
stderr_file=""
permission_mode=""
full_access=false
prompt_text=""
prompt_file=""
session_id=""
resume_id=""
persist=false
explicit_prompt=false
typeset -a positional_prompt=()
typeset -a extra_args=()

while (( $# > 0 )); do
  case "$1" in
    --detail) detail=true; shift ;;
    --artifact) require_value "$1" "$#"; artifacts+=("$2"); shift 2 ;;
    --canary-file) require_value "$1" "$#"; canary_file="$2"; shift 2 ;;
    --canary-expected) require_value "$1" "$#"; canary_expected="$2"; shift 2 ;;
    --provider)
      require_value "$1" "$#"
      provider="$2"
      shift 2
      ;;
    --instance)
      require_value "$1" "$#"
      instance="$2"
      shift 2
      ;;
    --cwd)
      require_value "$1" "$#"
      workdir="$2"
      shift 2
      ;;
    --output-format)
      require_value "$1" "$#"
      output_format="$2"
      shift 2
      ;;
    --output)
      require_value "$1" "$#"
      output_file="$2"
      shift 2
      ;;
    --stderr)
      require_value "$1" "$#"
      stderr_file="$2"
      shift 2
      ;;
    --permission-mode)
      require_value "$1" "$#"
      permission_mode="$2"
      shift 2
      ;;
    --full-access)
      full_access=true
      shift
      ;;
    --prompt)
      require_value "$1" "$#"
      [[ "$explicit_prompt" == false ]] || die "choose only one prompt input"
      prompt_text="$2"
      explicit_prompt=true
      shift 2
      ;;
    --prompt-file)
      require_value "$1" "$#"
      [[ "$explicit_prompt" == false ]] || die "choose only one prompt input"
      prompt_file="$2"
      explicit_prompt=true
      shift 2
      ;;
    --session-id)
      require_value "$1" "$#"
      session_id="$2"
      persist=true
      shift 2
      ;;
    --resume)
      require_value "$1" "$#"
      resume_id="$2"
      persist=true
      shift 2
      ;;
    --persist)
      persist=true
      shift
      ;;
    --no-persist)
      persist=false
      session_id=""
      shift
      ;;
    --list-providers)
      printf '%s\n' ds-flash mimo mimo-fast mimo-flash qwen kimi glm glm-flash local hy
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      extra_args=("$@")
      break
      ;;
    -*)
      die "unknown option: $1 (put Claude Code options after --)"
      ;;
    *)
      positional_prompt+=("$1")
      shift
      ;;
  esac
done

[[ -n "$provider" ]] || die "--provider is required"

case "$provider" in
  ds-flash|ds|deepseek|dflash)
    provider="ds-flash"
    runner="ds-flash_claude"
    ;;
  mimo|xiaomi)
    provider="mimo"
    runner="mimo_claude"
    ;;
  mimo-fast|mfast)
    provider="mimo-fast"
    runner="mimo-fast_claude"
    ;;
  mimo-flash|mflash)
    provider="mimo-flash"
    runner="mimo-flash_claude"
    ;;
  qwen)
    runner="qwen_claude"
    ;;
  kimi)
    runner="kimi_claude"
    ;;
  glm)
    runner="glm_claude"
    ;;
  glm-flash|gflash)
    provider="glm-flash"
    runner="glm-flash_claude"
    ;;
  local)
    runner="local_claude"
    ;;
  hy|hunyuan)
    provider="hy"
    runner="hy_claude"
    ;;
  *)
    die "unsupported provider: $provider"
    ;;
esac

[[ -n "$output_format" ]] || { if [[ "$detail" == true ]]; then output_format=json; else output_format=stream-json; fi; }

case "$output_format" in
  text|json|stream-json) ;;
  *) die "unsupported output format: $output_format" ;;
esac

[[ -d "$workdir" ]] || die "working directory does not exist: $workdir"
[[ -z "$session_id" || -z "$resume_id" ]] || die "--session-id and --resume cannot be used together"
[[ "$persist" == true || -z "$resume_id" ]] || die "--resume requires session persistence"
[[ "$persist" == true || -z "$session_id" ]] || die "--session-id requires session persistence"

if (( ${#positional_prompt[@]} > 0 )); then
  [[ "$explicit_prompt" == false ]] || die "positional prompt cannot be combined with --prompt or --prompt-file"
  prompt_text="${(j: :)positional_prompt}"
  explicit_prompt=true
fi

if [[ -n "$prompt_file" ]]; then
  if [[ "$prompt_file" == "-" ]]; then
    prompt_text="$(<&0)"
  else
    [[ -f "$prompt_file" && -r "$prompt_file" ]] || die "cannot read prompt file: $prompt_file"
    prompt_text="$(<"$prompt_file")"
  fi
elif [[ "$explicit_prompt" == false ]]; then
  [[ ! -t 0 ]] || die "provide --prompt, --prompt-file, positional text, or stdin"
  prompt_text="$(<&0)"
fi

command -v python3 >/dev/null 2>&1 || die "python3 is required for prompt validation"
print -rn -- "$prompt_text" | python3 -c 'import sys; sys.exit(0 if sys.stdin.read().strip() else 1)' \
  || die "prompt is unreadable, empty or whitespace-only"

run_uuid="$(new_uuid)"
[[ -n "$instance" ]] || instance="${provider}-${run_uuid[1,8]}"
[[ -n "$instance" ]] || die "instance name is empty"

if [[ "$persist" == true && -z "$session_id" && -z "$resume_id" ]]; then
  session_id="$run_uuid"
fi

readonly agent_tools_file="${AGENT_TOOLS_FILE:-$DEFAULT_AGENT_TOOLS_FILE}"
[[ -r "$agent_tools_file" ]] || die "cannot read launcher file: $agent_tools_file"

source "$agent_tools_file" || die "failed to load launcher file: $agent_tools_file"

setopt noclobber
umask 077

(( $+functions[$runner] )) || die "launcher function not found: $runner"
command -v claude >/dev/null 2>&1 || die "claude command not found"
command -v jq >/dev/null 2>&1 || die "jq command not found"

cd -- "$workdir" || die "cannot enter working directory: $workdir"

if [[ "$output_file" == "-" ]]; then
  output_file=""
elif [[ -n "$output_file" ]]; then
  prepare_output_path "$output_file"
  output_file="$REPLY"
fi

if [[ "$stderr_file" == "-" ]]; then
  stderr_file=""
elif [[ -n "$stderr_file" ]]; then
  prepare_output_path "$stderr_file"
  stderr_file="$REPLY"
fi

# Default collection always retains both streams, even without explicit destinations.
if [[ "$detail" == false ]]; then
  [[ "$output_format" != text ]] || die "--output-format text requires --detail"
  [[ "$output_format" == stream-json ]] || die "collected Claude runs require stream-json; use --detail for other formats"
  [[ -z "$canary_file" && -z "$canary_expected" || -n "$canary_file" && -n "$canary_expected" ]] || die "canary options must be paired"
  result_adapter="$agent_run_script_dir/agent-run-result.py"
  [[ -r "$result_adapter" ]] || die "result adapter missing: $result_adapter"
  command -v python3 >/dev/null 2>&1 || die "python3 is required for result collection"
  if [[ -z "$output_file" || -z "$stderr_file" ]]; then
    log_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-run.XXXXXXXX")" || die "cannot create log directory"
    [[ -n "$output_file" ]] || output_file="$log_dir/output.jsonl"
    [[ -n "$stderr_file" ]] || stderr_file="$log_dir/stderr.log"
  fi
fi

if [[ "$detail" == false ]]; then
  typeset -a normalized_artifacts=()
  for artifact in "${artifacts[@]}"; do
    prepare_output_path "$artifact"
    artifact="$REPLY"
    require_new_output "$artifact"
    require_distinct_outputs "$artifact" "$output_file"
    require_distinct_outputs "$artifact" "$stderr_file"
    normalized_artifacts+=("$artifact")
  done
  artifacts=("${normalized_artifacts[@]}")
fi

require_distinct_outputs "$output_file" "$stderr_file"
[[ -z "$output_file" ]] || require_new_output "$output_file"
[[ -z "$stderr_file" ]] || require_new_output "$stderr_file"

typeset -i stdout_fd=1 stderr_fd=2

typeset -a claude_args=(
  --print
  --output-format "$output_format"
  --name "$instance"
)

[[ "$output_format" == "stream-json" ]] && claude_args+=(--verbose)
[[ -n "$permission_mode" ]] && claude_args+=(--permission-mode "$permission_mode")
[[ "$full_access" == false || -z "$permission_mode" ]] || die "--full-access conflicts with --permission-mode"
[[ "$full_access" == true ]] && claude_args+=(--full-access)

if [[ -n "$resume_id" ]]; then
  claude_args+=(--resume "$resume_id")
elif [[ -n "$session_id" ]]; then
  claude_args+=(--session-id "$session_id")
else
  claude_args+=(--no-session-persistence)
fi

claude_args+=("${extra_args[@]}")
claude_args+=(-- "$prompt_text")

open_output_streams
"$runner" "${claude_args[@]}" >&$stdout_fd 2>&$stderr_fd
run_exit=$?

if [[ "$detail" == false ]]; then
  exec {stdout_fd}>&-
  exec {stderr_fd}>&-
  typeset -a collect_args=(--runtime claude --provider "$provider" --output "$output_file" --stderr "$stderr_file" --exit-code "$run_exit" --runner-exit-code "$run_exit")
  [[ -z "$canary_file" ]] || collect_args+=(--canary-file "${canary_file:A}" --canary-expected "${canary_expected:A}")
  for artifact in "${artifacts[@]}"; do collect_args+=(--artifact "${artifact:A}"); done
  collect_args+=(--wall-clock-seconds "$SECONDS")
  python3 "$result_adapter" "${collect_args[@]}"
  collect_exit=$?
  (( run_exit != 0 )) || run_exit=$collect_exit
fi
exit "$run_exit"
