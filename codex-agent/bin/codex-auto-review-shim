#!/usr/bin/env python3
"""Rewrite the Codex auto-review model slug on its way to a provider.

Codex's guardian (approvals_reviewer = "auto_review") always asks for the
catalog model id `codex-auto-review`, but inherits the session's provider.
Third-party endpoints do not serve that id, so every escalation fails closed.

This shim sits in front of a provider and maps the guardian model id and the
managed route's logical model id to the selected upstream model. It passes
other model ids through, including compressed bodies and streaming responses.

Multi-route mode (one process, one listener per provider):

  SHIM_ROUTES   path to a routes file (default ~/.codex-agent/shim-routes.json)

    {
      "bind": "127.0.0.1",
      "routes": [
        {"port": 8788, "endpoint_id": "ds-flash", "request_prefix": "/v1", "to": "deepseek-flash"}
      ]
    }

  Managed routes resolve a base URL, upstream model and Bearer API key from
  one snapshot of user-owned ~/.config/agent-tools/endpoints.json on every
  request. Incoming credentials are replaced; redirects are refused.
  request_prefix is
  stripped from the incoming path before appending it to that upstream base.
  Explicit upstream routes (e.g. test/single-route deployments) forward the
  path verbatim, de-duplicating a trailing /v1 prefix.

Single-route mode (no routes file) -- configured entirely by environment:

  SHIM_LISTEN     host:port to bind          (default 127.0.0.1:8788)
  SHIM_UPSTREAM   provider origin            (default https://api.deepseek.com)
  SHIM_FROM       model id to replace        (default codex-auto-review)
  SHIM_TO         replacement model id       (default deepseek-flash)

Other flags:

  --routes           print the resolved routes and exit
  --check '<json>'   print the rewritten body for a sample request and exit
"""

import gzip
import http.client
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
import zlib
import importlib.util
from functools import lru_cache
from pathlib import Path
from types import MappingProxyType
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DEFAULT_ROUTES = os.path.expanduser("~/.codex-agent/shim-routes.json")
# Non-2xx responses get their request body dumped here, for diagnosis.
FAILED_DIR = os.path.expanduser("~/.codex-agent/shim-failed")

# Framing headers we must not copy: the body may change length, and the
# response is re-framed by connection close.
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailers", "transfer-encoding", "upgrade", "host", "content-length",
}

DECODERS = {"gzip": gzip.decompress, "deflate": zlib.decompress}
ENCODERS = {"gzip": gzip.compress, "deflate": zlib.compress}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None  # A redirect must not forward the selected gateway key.


def upstream_open(req, timeout):
    return urllib.request.build_opener(NoRedirect).open(req, timeout=timeout)


def upstream_url(upstream: str, path: str) -> str:
    """Join an origin with the incoming path without duplicating a /v1 prefix."""
    if upstream.endswith("/v1") and path.startswith("/v1/"):
        return upstream[: -len("/v1")] + path
    return upstream + path


@lru_cache(maxsize=1)
def endpoint_module():
    helper = Path(__file__).with_name("agent-endpoint.py")
    if not helper.exists():
        helper = Path(__file__).resolve().parents[2] / "scripts/agent-endpoint.py"
    if not helper.is_file():
        raise ValueError("agent-endpoint.py unavailable; run scripts/sync-codex-agent.sh")
    spec = importlib.util.spec_from_file_location("agent_endpoint", helper)
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    except OSError:
        raise ValueError("cannot load agent-endpoint.py; run scripts/sync-codex-agent.sh") from None
    return module


def route_url(route, path, selected=None):
    # Reload the user-owned endpoint on every request: editing a URL requires
    # neither synchronization nor a service restart, including App sessions.
    upstream = ((selected or endpoint_module().connection(route["endpoint_id"], "codex"))["base_url"]
                if route.get("endpoint_id") else route["upstream"])
    prefix = route.get("request_prefix", "")
    if prefix:
        if not path.startswith(prefix + "/"):
            raise ValueError("Unexpected route prefix")
        return upstream + path[len(prefix):]
    return upstream_url(upstream, path)


def _swap(body: bytes, src: str, dst: str) -> tuple[bytes, str]:
    """Replace the model id in an uncompressed body. `how` is none/json."""
    try:
        doc = json.loads(body)
    except Exception:
        return body, "none"
    if isinstance(doc, dict) and doc.get("model") == src:
        if src == dst:
            return body, "none"
        doc["model"] = dst
        return json.dumps(doc, ensure_ascii=False, separators=(",", ":")).encode(), "json"
    return body, "none"


def fix_message_ids(body: bytes) -> tuple[bytes, int]:
    """Rewrite `at_`-prefixed input-item ids to `msg_`.

    Some providers (dashscope among them) validate that every message id starts
    with `msg_`, but Codex labels its `additional_tools` developer item `at_<uuid>`.
    Only the prefix is rewritten, so the ids stay unique.
    """
    out, n = re.subn(rb'"id":"at_', b'"id":"msg_', body)
    return out, n


def json_object_format(body: bytes) -> tuple[bytes, int]:
    """Downgrade a `json_schema` text format to `json_object`.

    Some providers reject schema-constrained output outright ("text.format type
    'json_schema' is not supported"). The required shape is still described in
    the prompt, so the model is not left without guidance -- it just loses the
    hard constraint.
    """
    try:
        doc = json.loads(body)
    except Exception:
        return body, 0
    text = doc.get("text") if isinstance(doc, dict) else None
    fmt = text.get("format") if isinstance(text, dict) else None
    if not isinstance(fmt, dict) or fmt.get("type") != "json_schema":
        return body, 0
    text["format"] = {"type": "json_object"}
    return json.dumps(doc, ensure_ascii=False, separators=(",", ":")).encode(), 1


def drop_tools_item(body: bytes) -> tuple[bytes, int]:
    """Remove `additional_tools` input items.

    Codex delivers the guardian's tool set as an input item whose `type` is
    `additional_tools`. Servers that validate item types reject it outright
    ("Cannot determine type of 'item'"). Dropping it leaves the guardian with
    no tools -- it is a judging task, so that is acceptable -- and the custom
    `exec` tool disappears along with the item, so no catalog change is needed.
    """
    try:
        doc = json.loads(body)
    except Exception:
        return body, 0
    inp = doc.get("input") if isinstance(doc, dict) else None
    if not isinstance(inp, list):
        return body, 0
    kept = [
        it for it in inp
        if not (isinstance(it, dict) and it.get("type") == "additional_tools")
    ]
    if len(kept) == len(inp):
        return body, 0
    doc["input"] = kept
    return json.dumps(doc, ensure_ascii=False, separators=(",", ":")).encode(), len(inp) - len(kept)


def fix_agent_messages(body: bytes) -> tuple[bytes, int]:
    """Adapt native v2 inter-agent items for a non-native Responses gateway.

    Observed Codex 0.167.0 agent_message encrypted_content slots contain
    plaintext. This route-specific compatibility assumption is NOT decryption;
    actual opaque ciphertext cannot be recovered here. Never visit reasoning,
    tool arguments, or ordinary messages. Validate the whole request before
    returning anything so an unknown variant cannot become a partial task.
    """
    try:
        doc = json.loads(body)
    except ValueError:
        return body, 0
    items = doc.get("input") if isinstance(doc, dict) else None
    if not isinstance(items, list):
        return body, 0
    converted, count = [], 0
    for index, item in enumerate(items):
        if not isinstance(item, dict) or item.get("type") != "agent_message":
            converted.append(item)
            continue
        # Error text contains positions only, never arbitrary keys or content.
        error = f"Invalid agent_message at input[{index}]"
        if any(not isinstance(item.get(k), str) or not item[k] for k in ("author", "recipient")):
            raise ValueError(error)
        content = item.get("content")
        if not isinstance(content, list) or not content:
            raise ValueError(error)
        texts = []
        for part in content:
            if not isinstance(part, dict):
                raise ValueError(error)
            kind = part.get("type")
            key = ({"input_text": "text", "encrypted_content": "encrypted_content"}.get(kind)
                   if isinstance(kind, str) else None)
            if key is None or set(part) != {"type", key} or not isinstance(part[key], str):
                raise ValueError(error)
            texts.append({"type": "input_text", "text": part[key]})
        # Carry routing/metadata as text, not unsupported protocol fields.
        # Preserve all original non-content fields, including the native id,
        # without presenting amsg_ as a provider message id or elevating role.
        metadata = {k: v for k, v in item.items() if k not in {"type", "content"}}
        envelope = ("Native agent_message metadata: "
                    + json.dumps(metadata, ensure_ascii=False, separators=(",", ":")) + "\n")
        converted.append({"type": "message", "role": "user", "content": [
            {"type": "input_text", "text": envelope}, *texts,
        ]})
        count += 1
    if not count:
        return body, 0
    doc["input"] = converted
    try:
        return json.dumps(doc, ensure_ascii=False, separators=(",", ":")).encode(), count
    except UnicodeEncodeError:
        raise ValueError("Invalid agent_message Unicode") from None


def rewrite(body: bytes, encoding: str, src: str, dst: str) -> tuple[bytes, str]:
    """Return (body, how). Decompresses, rewrites, and restores the encoding.

    Unrewritable cases return the body unchanged -- callers must surface the
    returned `how` so a silent pass-through is visible in the log.
    """
    enc = (encoding or "").strip().lower()
    if not body:
        return body, "none"
    if enc not in ("", "identity"):
        decode = DECODERS.get(enc)
        if decode is None:
            return body, f"passthrough:{enc}"  # unknown codec: cannot rewrite
        try:
            plain = decode(body)
        except Exception:
            return body, f"undecodable:{enc}"
        out, how = _swap(plain, src, dst)
        if how == "none":
            return body, "none"
        return ENCODERS[enc](out), how

    return _swap(body, src, dst)


# Only actual native descriptor groups are eligible. Maps never outlive a request.
NATIVE_AGENT_GROUPS = frozenset(("multi_agent_v1", "collaboration"))
NATIVE_RESPONSE_LIMIT = 8 * 1024 * 1024


class NativeProtocolError(ValueError):
    def __init__(self):
        super().__init__("Invalid native agent protocol")


def native_agent_request(body: bytes, flatten: bool):
    """Map current native declarations; flatten only top-level Kimi tools."""
    try:
        doc = json.loads(body)
    except (ValueError, UnicodeError):
        return body, MappingProxyType({})
    tools = doc.get("tools") if isinstance(doc, dict) else None
    if not isinstance(doc, dict) or (flatten and not isinstance(tools, list)):
        return body, MappingProxyType({})
    containers = [tools] if isinstance(tools, list) else []
    if isinstance(doc.get("input"), list):
        containers.extend(item["tools"] for item in doc["input"]
                          if isinstance(item, dict) and item.get("type") == "additional_tools"
                          and isinstance(item.get("tools"), list))
    candidates = tools if flatten else [t for container in containers for t in container]
    selected = [t for t in candidates if isinstance(t, dict) and t.get("type") == "namespace"
                and isinstance(t.get("name"), str) and t["name"] in NATIVE_AGENT_GROUPS]
    if not selected:
        return body, MappingProxyType({})
    mapping = {}
    for group in selected:
        if (not isinstance(group.get("tools"), list)
                or ("description" in group and not isinstance(group["description"], str))
                or (flatten and set(group) - {"type", "name", "description", "tools"})):
            raise NativeProtocolError()
        for child in group["tools"]:
            if (not isinstance(child, dict) or child.get("type") != "function"
                    or not isinstance(child.get("name"), str) or not child["name"]
                    or (flatten and "description" in child and not isinstance(child["description"], str))
                    or child["name"] in mapping):
                raise NativeProtocolError()
            mapping[child["name"]] = group["name"]
    if not mapping:
        return body, MappingProxyType({})

    def declarations(items):
        for item in items:
            if not isinstance(item, dict):
                continue
            # Namespace names label groups, not bare callable declarations.
            if item.get("type") == "namespace":
                if isinstance(item.get("tools"), list):
                    yield from declarations(item["tools"])
            else:
                yield item

    others = [t for container in containers for t in container if not any(t is g for g in selected)]
    for item in declarations(others):
        name = item.get("name")
        if isinstance(name, str) and name in mapping:
            raise NativeProtocolError()
    if not flatten:
        return body, MappingProxyType(mapping)
    choice = doc.get("tool_choice")
    if isinstance(choice, dict):
        for target in (choice, choice.get("function")):
            if isinstance(target, dict) and ((isinstance(target.get("namespace"), str) and target["namespace"] in NATIVE_AGENT_GROUPS)
                    or (isinstance(target.get("name"), str) and target["name"] in NATIVE_AGENT_GROUPS)
                    or (isinstance(target.get("name"), str) and target["name"] in mapping
                        and target.get("namespace") in (None, *NATIVE_AGENT_GROUPS))):
                raise NativeProtocolError()
    flat = []
    for item in tools:
        if not any(item is g for g in selected):
            flat.append(item)
            continue
        prefix = "Namespace " + item["name"] + ": " + item.get("description", "") + "\n\n"
        flat.extend({**child, "description": prefix + child.get("description", "")} for child in item["tools"])
    doc["tools"] = flat
    try:
        return json.dumps(doc, ensure_ascii=False).encode("utf-8"), MappingProxyType(mapping)
    except UnicodeError:
        raise NativeProtocolError() from None


def restore_native_response(payload: bytes, mapping, event=False):
    """Namespace-only repair at evidenced Responses output locations."""
    try:
        doc = json.loads(payload)
    except (ValueError, UnicodeError):
        raise NativeProtocolError() from None
    count = 0

    def restore(item):
        nonlocal count
        if not isinstance(item, dict) or item.get("type") != "function_call":
            return
        name = item.get("name")
        if not isinstance(name, str) or name not in mapping:
            return
        namespace = item.get("namespace")
        if namespace is None:
            item["namespace"] = mapping[name]
            count += 1
        elif namespace != mapping[name]:
            raise NativeProtocolError()

    if isinstance(doc, dict):
        if event:
            if doc.get("type") in ("response.output_item.added", "response.output_item.done"):
                restore(doc.get("item"))
            elif doc.get("type") == "response.completed" and isinstance(doc.get("response"), dict):
                for item in doc["response"].get("output", []) or []:
                    restore(item)
        else:
            for item in doc.get("output", []) or []:
                restore(item)
    try:
        return (json.dumps(doc, ensure_ascii=False).encode("utf-8") if count else payload), count
    except (UnicodeError, TypeError):
        raise NativeProtocolError() from None


def restore_native_sse_event(raw, mapping):
    try:
        raw.decode("utf-8")
    except UnicodeError:
        raise NativeProtocolError() from None
    lines = raw.splitlines(keepends=True)
    data = []
    for line in lines:
        content = line.rstrip(b"\r\n")
        if content == b"data" or content.startswith(b"data:"):
            value = content[5:] if content.startswith(b"data:") else b""
            data.append(value[1:] if value.startswith(b" ") else value)
    if not data or b"\n".join(data) == b"[DONE]":
        return raw, 0
    fixed, count = restore_native_response(b"\n".join(data), mapping, event=True)
    if not count:
        return raw, 0
    out, emitted = [], False
    for line in lines:
        content = line.rstrip(b"\r\n")
        if content == b"data" or content.startswith(b"data:"):
            if not emitted:
                ending = line[len(content):]
                out.append(b"data: " + fixed + ending)
                emitted = True
        else:
            out.append(line)
    return b"".join(out), count


def native_sse_events(read, mapping):
    """Incremental SSE framing; buffer one bounded event, never a whole stream."""
    pending = bytearray()
    scan = line_start = 0
    while True:
        chunk = read(65536)
        eof = not chunk
        pending.extend(chunk)
        while scan < len(pending):
            match = re.compile(b"[\r\n]").search(pending, scan)
            if match is None:
                scan = len(pending)
                break
            end = match.start()
            if pending[end] == 13 and end + 1 == len(pending) and not eof:
                scan = end
                break  # CRLF can be split between reads.
            after = end + (2 if pending[end:end+2] == b"\r\n" else 1)
            if after > NATIVE_RESPONSE_LIMIT:
                raise NativeProtocolError()
            if end == line_start:
                raw = bytes(pending[:after])
                del pending[:after]
                scan = line_start = 0
                yield restore_native_sse_event(raw, mapping)
            else:
                scan = line_start = after
        if len(pending) > NATIVE_RESPONSE_LIMIT:
            raise NativeProtocolError()
        if eof:
            if pending:
                raise NativeProtocolError()
            return


def load_routes() -> list[dict]:
    """Return the resolved route list, or [] for single-route env mode."""
    path = os.environ.get("SHIM_ROUTES") or (
        DEFAULT_ROUTES if os.path.exists(DEFAULT_ROUTES) else ""
    )
    if not path:
        return []
    with open(path, encoding="utf-8") as fh:
        doc = json.load(fh)
    if not isinstance(doc, dict) or not isinstance(doc.get("routes"), list):
        raise SystemExit("routes config must be an object containing a routes array")
    default_from = doc.get("from", "codex-auto-review")
    bind = doc.get("bind", "127.0.0.1")
    routes = []
    endpoints = None
    for i, r in enumerate(doc.get("routes") or []):
        if not isinstance(r, dict):
            raise SystemExit(f"routes[{i}] must be an object")
        for key in ("port", "to"):
            if key not in r:
                raise SystemExit(f"routes[{i}] missing {key!r}")
        upstream = r.get("upstream")
        if "endpoint_id" in r:
            if endpoints is None:
                module = endpoint_module()
                endpoints = module.load_endpoints()
            upstream = module.endpoint(r["endpoint_id"], "codex", endpoints)
        if not upstream:
            raise SystemExit(f"routes[{i}] missing upstream endpoint")
        if r.get("native_agent_request_flatten", False) and not r.get("native_agent_response_restore", False):
            raise SystemExit("native request flatten requires response restore")
        routes.append({
            "listen": f"{r.get('bind', bind)}:{int(r['port'])}",
            "upstream": str(upstream).rstrip("/"),
            "request_prefix": r.get("request_prefix", ""),
            "endpoint_id": r.get("endpoint_id"),
            "from": r.get("from", default_from),
            "to": str(r["to"]),
            "id_fix": bool(r.get("id_fix", doc.get("id_fix", False))),
            "json_fmt_fix": bool(r.get("json_fmt_fix", doc.get("json_fmt_fix", False))),
            "drop_tools_item": bool(r.get("drop_tools_item", doc.get("drop_tools_item", False))),
            "agent_message_fix": bool(r.get("agent_message_fix", False)),
            "native_agent_request_flatten": bool(r.get("native_agent_request_flatten", False)),
            "native_agent_response_restore": bool(r.get("native_agent_response_restore", False)),
        })
    if not routes:
        raise SystemExit(f"no routes defined in {path}")
    return routes


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "codex-auto-review-shim"

    def log_message(self, fmt, *args):  # keep the default noise out
        pass

    @property
    def route(self) -> dict:
        return self.server.route

    def _log(self, msg):
        print(f"[shim:{self.route['port']}] {msg}", file=sys.stderr, flush=True)

    def _dump(self, body: bytes, tag: str, kind: str = "req") -> None:
        """Persist a request or response body that produced a bad outcome."""
        try:
            os.makedirs(FAILED_DIR, exist_ok=True)
            path = os.path.join(
                FAILED_DIR,
                f"{self.route['port']}-{int(time.time())}-{kind}-{tag}.json",
            )
            with open(path, "wb") as fh:
                fh.write(body)
            self._log(f"  ^ {kind} 已存：{path}")
        except Exception as e:
            self._log(f"  ^ {kind} 保存失败：{e}")

    @staticmethod
    def _summary(body: bytes, encoding: str) -> tuple[str, str]:
        """Return (model, tool-names) for the request body, for the log line."""
        try:
            raw = body
            if encoding:
                dec = DECODERS.get(encoding.strip().lower())
                if dec:
                    raw = dec(raw)
            doc = json.loads(raw)
        except Exception:
            return "?", "-"
        if not isinstance(doc, dict):
            return "?", "-"
        names = []
        tools = doc.get("tools")
        for t in tools if isinstance(tools, list) else []:
            if not isinstance(t, dict):
                names.append("?"); continue
            fn = t.get("function") if isinstance(t.get("function"), dict) else {}
            names.append(str(t.get("name") or fn.get("name") or t.get("type") or "?"))
        if not names:
            return str(doc.get("model")), "none"
        extra = f",+{len(names) - 12}" if len(names) > 12 else ""
        return str(doc.get("model")), "[" + ",".join(names[:12]) + extra + "]"

    def _relay_native_response(self, resp, mapping):
        """An active map has an explicit identity-only success-body contract."""
        sent = False
        count = relayed = 0
        read = getattr(resp, "read1", None) or resp.read
        try:
            encodings = resp.headers.get_all("Content-Encoding", [])
            if any(value.strip().lower() != "identity" for value in encodings):
                raise NativeProtocolError()
            media = (resp.headers.get("Content-Type") or "").split(";", 1)[0].strip().lower()
            if media == "text/event-stream":
                events = native_sse_events(read, mapping)
            elif media == "application/json":
                data = bytearray()
                while True:
                    chunk = read(min(65536, NATIVE_RESPONSE_LIMIT + 1 - len(data)))
                    if not chunk:
                        break
                    data.extend(chunk)
                    if len(data) > NATIVE_RESPONSE_LIMIT:
                        raise NativeProtocolError()
                events = iter((restore_native_response(bytes(data), mapping),))
            else:
                raise NativeProtocolError()
            # Validate the first whole event before committing downstream headers.
            first = next(events, None)
            self.send_response(resp.status)
            hop_headers = HOP_BY_HOP | {"trailer"} | {token.strip().lower() for value in resp.headers.get_all("Connection", []) for token in value.split(",")}
            for key, value in resp.headers.items():
                if key.lower() not in hop_headers:
                    self.send_header(key, value)
            self.send_header("Connection", "close")
            self.end_headers()
            sent = True
            if first is not None:
                chunk, n = first
                self.wfile.write(chunk)
                self.wfile.flush()
                relayed += len(chunk)
                count += n
            for chunk, n in events:
                self.wfile.write(chunk)
                self.wfile.flush()
                relayed += len(chunk)
                count += n
            self._log(f"native response: restored={count} relayed={relayed}B")
        except (NativeProtocolError, http.client.HTTPException, OSError, ValueError, TypeError):
            self._log("native response: invalid protocol")
            if not sent:
                self.send_error(502, "Invalid native agent protocol")
        finally:
            self.close_connection = True
            resp.close()

    def _handle(self):
        route = self.route
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        encoding = self.headers.get("Content-Encoding") or ""
        how = "none"
        # Resolve a single URL/model/key snapshot for this request. API keys
        # belong to the shim, not the Codex process, argv, catalog or plist.
        selected = None
        try:
            if route.get("endpoint_id"):
                selected = endpoint_module().connection(route["endpoint_id"], "codex", require_key=True)
            url = route_url(route, self.path, selected)
        except ValueError:
            self._log("connection error: invalid private settings or missing selected API key")
            self.send_error(503, "Invalid private connection settings")
            return
        # Determine guardian status from the ORIGINAL request, independently
        # of ordinary model aliases; normal remapping must remain streaming.
        enc = encoding.strip().lower()
        plain = body
        if enc not in ("", "identity"):
            if enc not in DECODERS:
                plain, how = None, f"passthrough:{enc}"
            else:
                try:
                    plain = DECODERS[enc](body)
                except (ValueError, OSError, zlib.error):
                    plain, how = None, f"undecodable:{enc}"
        try:
            request_model = json.loads(plain).get("model") if plain else None
        except (ValueError, AttributeError):
            request_model = None
        guardian = request_model == route["from"]
        native_map = MappingProxyType({})
        if plain:
            target = selected["upstream_model"] if selected else route["to"]
            source = route["from"] if guardian else route["to"]
            transformed, n = plain, 0
            if route.get("agent_message_fix"):
                try:
                    transformed, n = fix_agent_messages(transformed)
                except ValueError as exc:
                    self._log(str(exc))
                    self.send_error(400, str(exc))
                    return
            if (not guardian and route.get("native_agent_response_restore")
                    and self.path.split("?", 1)[0].endswith("/responses")):
                try:
                    transformed, native_map = native_agent_request(transformed, route.get("native_agent_request_flatten", False))
                except NativeProtocolError:
                    self._log("native request: invalid protocol")
                    self.send_error(400, "Invalid native agent protocol")
                    return
            transformed, how = _swap(transformed, source, target)
            if n:
                how = f"{how}+agentmsg{n}"
            if route.get("id_fix"):
                transformed, n = fix_message_ids(transformed)
                if n:
                    how = f"{how}+idfix{n}"
            if route.get("json_fmt_fix"):
                transformed, n = json_object_format(transformed)
                if n:
                    how = f"{how}+jsonfmt{n}"
            if route.get("drop_tools_item"):
                transformed, n = drop_tools_item(transformed)
                if n:
                    how = f"{how}+droptools{n}"
            if transformed != plain:
                body = ENCODERS[enc](transformed) if enc in ENCODERS else transformed

        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP_BY_HOP}
        if selected:
            headers = {k: v for k, v in headers.items() if k.lower() not in {"authorization", "x-api-key", "api-key"}}
            headers["Authorization"] = "Bearer " + selected["api_key"]
        req = urllib.request.Request(url, data=body or None, headers=headers, method=self.command)

        # Guardian requests (identified before rewriting) get buffered-and-retried: a
        # half-delivered stream cannot be unsent, and the verdict call is small
        # enough that buffering costs nothing. Upstreams have been observed to
        # cut SSE mid-reasoning ("read SSE stream: unexpected EOF") in transient
        # windows, which fails the escalation closed for no reason.
        resp = None
        data = b""
        note = "ok"
        done = False
        attempts = (1, 2, 3) if guardian else (1,)
        for attempt in attempts:
            try:
                resp = upstream_open(req, timeout=180)
            except urllib.error.HTTPError as e:
                resp = e
            except Exception as e:
                self._log(f"{self.command} {self.path} UPSTREAM ERROR(attempt {attempt}): {e}")
                resp, note = None, f"error:{type(e).__name__}"
                continue
            if not (200 <= resp.status < 300):
                data = resp.read()
                note = f"http{resp.status}"
                break
            if guardian:
                try:
                    data = resp.read()
                except (http.client.HTTPException, OSError) as exc:
                    resp.close()
                    resp, data, note = None, b"", f"error:{type(exc).__name__}"
                    self._log(f"  ^ attempt {attempt}: guardian read failed ({type(exc).__name__}), retrying")
                    continue
            else:
                data = b""
            if guardian:
                done = b"response.completed" in data
                if done:
                    break
                note = "nostream"
                resp.close()
                self._log(f"  ^ attempt {attempt}: incomplete stream ({len(data)}B), retrying")
                continue
            break  # non-guardian: stream below, no retry

        if resp is None:
            self.send_response(502)
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            return

        warn = "" if how.split("+")[0] in ("bytes", "json", "none") else f"  <<< 未能改写（{how}）"
        model, tools = self._summary(body, encoding)
        self._log(
            f"{self.command} {self.path} -> {resp.status} "
            f"model={model} enc={encoding or '-'} rewrite={how} tools={tools}{warn}"
        )

        if native_map and 200 <= resp.status < 300:
            self._relay_native_response(resp, native_map)
            return

        if not (200 <= resp.status < 300) and body:
            self._dump(body, str(resp.status))

        self.send_response(resp.status)
        for k, v in resp.headers.items():
            if k.lower() not in HOP_BY_HOP:
                self.send_header(k, v)
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

        head = bytearray()
        if guardian or (native_map and not (200 <= resp.status < 300)):
            # Already buffered in full above; forward in one piece.
            relayed = len(data)
            head.extend(data[:8192])
            try:
                self.wfile.write(data)
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                note = "client-gone"
        else:
            # read1() hands back data as soon as any is available. read(n)
            # blocks until n bytes accumulate, which buffers SSE and lets the
            # client's stall protection fire ("stream closed before
            # response.completed").
            read = getattr(resp, "read1", None) or resp.read
            relayed, prev = 0, b""
            try:
                while True:
                    chunk = read(65536)
                    if not chunk:
                        break
                    relayed += len(chunk)
                    # Scan the whole stream, not just the head: the terminal
                    # event arrives at the END of a long SSE response.
                    if not done and b"response.completed" in prev + chunk:
                        done = True
                    prev = chunk[-32:]      # tolerate a marker split across chunks
                    if len(head) < 8192:
                        head.extend(chunk[: 8192 - len(head)])
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except http.client.IncompleteRead as e:
                relayed += len(e.partial or b"")
                note = "TRUNCATED"      # upstream cut the stream mid-body
            except (BrokenPipeError, ConnectionResetError):
                note = "client-gone"
            except Exception as e:
                note = f"error:{type(e).__name__}"

        # A 2xx status only says the headers arrived. The body can still be cut
        # short (TRUNCATED), or be a complete-but-not-a-stream error payload --
        # in which case the client reports "stream closed before response.completed".
        self._log(
            f"  ^ status={resp.status} stream={note} relayed={relayed}B "
            f"completed={done}"
        )
        if body and (note == "TRUNCATED" or (how.split("+")[0] == "json" and not done)):
            self._dump(body, note if note != "ok" else "nostream")
            self._dump(bytes(head), note if note != "ok" else "nostream", kind="resp")
        elif not (200 <= resp.status < 300) and head:
            # The error message lives in the response body -- always keep it.
            self._dump(bytes(head), str(resp.status), kind="resp")

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = _handle


def _make_server(route: dict):
    host, _, port = route["listen"].rpartition(":")
    srv = ThreadingHTTPServer((host or "127.0.0.1", int(port)), Handler)
    srv.route = {**route, "port": int(port)}
    return srv


def main():
    argv = sys.argv[1:]

    if argv[:1] == ["--check"]:
        if len(argv) != 2:
            raise SystemExit("usage: --check '<json>'")
        out, how = rewrite(argv[1].encode(), "", "codex-auto-review", "deepseek-flash")
        print(f"how={how}")
        print(out.decode())
        return 0

    try:
        routes = load_routes()
    except (ValueError, OSError, TypeError) as exc:
        raise SystemExit(f"invalid routes configuration: {exc}") from None
    if not routes:
        routes = [{
            "listen": os.environ.get("SHIM_LISTEN", "127.0.0.1:8788"),
            "upstream": os.environ.get("SHIM_UPSTREAM", "https://api.deepseek.com").rstrip("/"),
            "from": os.environ.get("SHIM_FROM", "codex-auto-review"),
            "to": os.environ.get("SHIM_TO", "deepseek-flash"),
        }]

    if argv[:1] == ["--routes"]:
        for r in routes:
            print(f"{r['listen']:>16}  {('endpoint:' + r['endpoint_id']) if r.get('endpoint_id') else r['upstream']}   ({r['from']} -> {r['to']})")
        return 0

    servers = []
    for r in routes:
        try:
            servers.append(_make_server(r))
        except OSError as e:
            print(f"[shim] cannot bind {r['listen']}: {e}", file=sys.stderr, flush=True)
            return 1
        print(
            f"[shim] {r['listen']} -> {('endpoint:' + r['endpoint_id']) if r.get('endpoint_id') else r['upstream']}  ({r['from']} -> {r['to']})",
            file=sys.stderr, flush=True,
        )

    for srv in servers[1:]:
        threading.Thread(target=srv.serve_forever, daemon=True).start()
    try:
        servers[0].serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
